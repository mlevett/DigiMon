<service>
  <id>DigiMon</id>
  <name>DigiMon</name>
  <description>Receive-only APRS digipeater monitor</description>
  <executable>C:\PATH\TO\python.exe</executable>
  <arguments>-m digimon run --config "C:\DigiMon\config.json" --data-dir "C:\DigiMon\data"</arguments>
  <workingdirectory>C:\DigiMon\app</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>45sec</stoptimeout>
  <onfailure action="restart" delay="15 sec"/>
  <log mode="roll"/>
</service>
